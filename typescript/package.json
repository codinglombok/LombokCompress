{
  "name": "lombokcompress",
  "version": "0.1.1",
  "description": "Universal zero-dependency compression library — LZ4, Zstandard, Deflate/gzip/zlib. Part of Lombok Ecosystem.",
  "author": "codinglombok <codinglombok@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokCompress"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./lz4": {
      "types": "./dist/esm/lz4/index.d.ts",
      "import": "./dist/esm/lz4/index.js",
      "require": "./dist/cjs/lz4/index.js"
    },
    "./deflate": {
      "types": "./dist/esm/deflate/index.d.ts",
      "import": "./dist/esm/deflate/index.js",
      "require": "./dist/cjs/deflate/index.js"
    },
    "./zstd": {
      "types": "./dist/esm/zstd/index.d.ts",
      "import": "./dist/esm/zstd/index.js",
      "require": "./dist/cjs/zstd/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "test": "node --test test/compress.test.mjs"
  },
  "keywords": [
    "compression",
    "lz4",
    "zstd",
    "zstandard",
    "deflate",
    "gzip",
    "zlib",
    "zero-dependency",
    "lombok-ecosystem"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
